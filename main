html = r'''<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>마린스키극장에서</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            width: 100%;
            height: 100%;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "SF Pro Text",
                "Noto Sans KR",
                "Apple SD Gothic Neo",
                sans-serif;
        }

        body {
            background: #111;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* 휴대폰 */
        .phone {
            width: min(100vw, 430px);
            height: min(100dvh, 900px);
            background: #f2f2f7;

            display: flex;
            flex-direction: column;

            position: relative;
            overflow: hidden;
        }

        /* 데스크톱 */
        @media (min-width: 600px) {
            .phone {
                height: min(900px, calc(100vh - 30px));

                border-radius: 32px;
                border: 1px solid #333;

                box-shadow:
                    0 20px 60px rgba(0, 0, 0, 0.45);
            }
        }

        /* 상태바 */
        .status-bar {
            height: 28px;
            flex-shrink: 0;

            padding: 0 18px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            background: rgba(248, 248, 250, 0.96);

            font-size: 12px;
            font-weight: 600;

            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .status-right {
            display: flex;
            gap: 7px;
            align-items: center;
        }

        /* 채팅 헤더 */
        .chat-header {
            height: 64px;
            flex-shrink: 0;

            display: grid;
            grid-template-columns: 45px 1fr 45px;
            align-items: center;

            padding: 0 8px;

            background: rgba(248, 248, 250, 0.96);

            border-bottom: 1px solid #d1d1d6;

            backdrop-filter: blur(15px);
        }

        .header-button {
            border: none;
            background: none;

            color: #007aff;

            font-size: 28px;

            cursor: pointer;
        }

        .profile {
            text-align: center;
            min-width: 0;
        }

        .avatar {
            width: 30px;
            height: 30px;

            margin: auto;

            border-radius: 50%;

            display: flex;
            justify-content: center;
            align-items: center;

            background: linear-gradient(
                145deg,
                #222,
                #777
            );

            color: white;

            font-size: 12px;
            font-weight: bold;
        }

        .name {
            margin-top: 2px;

            font-size: 13px;
            font-weight: 650;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .status {
            color: #8e8e93;
            font-size: 9px;
        }

        /* 메시지 영역 */
        .messages {
            flex: 1;

            overflow-y: auto;

            padding: 14px 12px 14px;

            scroll-behavior: smooth;

            overscroll-behavior: contain;
        }

        .date {
            text-align: center;

            color: #8e8e93;

            font-size: 11px;

            margin-bottom: 12px;
        }

        .message-row {
            display: flex;
            flex-direction: column;

            margin: 7px 0;

            animation: messageAppear 0.3s ease-out;
        }

        .incoming {
            align-items: flex-start;
        }

        .outgoing {
            align-items: flex-end;
        }

        .sender {
            color: #666;

            font-size: 11px;

            margin:
                0 0 4px 5px;
        }

        .bubble {
            max-width: 78%;

            padding:
                9px 13px;

            border-radius: 18px;

            font-size: 16px;
            line-height: 1.42;

            word-break: keep-all;
        }

        /* 유빈 */
        .incoming .bubble {
            background: #e5e5ea;

            border-bottom-left-radius: 6px;
        }

        /* 방문자 */
        .outgoing .bubble {
            background: white;

            border:
                1px solid #dedee2;

            border-bottom-right-radius: 6px;
        }

        .time {
            color: #8e8e93;

            font-size: 10px;

            margin:
                3px 5px 0;
        }

        .error {
            color: #ff3b30;

            font-size: 11px;

            margin:
                3px 6px 0;

            animation: messageAppear 0.2s ease-out;
        }

        /* 입력 영역 */
        .notice {
            flex-shrink: 0;

            padding: 0 10px 5px;

            background: rgba(248, 248, 250, 0.96);

            color: #8e8e93;

            text-align: center;

            font-size: 9px;
        }

        .composer {
            flex-shrink: 0;

            display: flex;
            align-items: flex-end;

            gap: 7px;

            padding:
                8px 10px
                calc(8px + env(safe-area-inset-bottom));

            background: rgba(248, 248, 250, 0.96);

            border-top: 1px solid #d1d1d6;
        }

        .input {
            flex: 1;

            min-width: 0;
            min-height: 38px;
            max-height: 100px;

            resize: none;

            padding:
                8px 13px;

            border:
                1px solid #c7c7cc;

            border-radius: 19px;

            background: white;

            font:
                16px/1.35
                inherit;

            outline: none;
        }

        .input:focus {
            border-color: #999;
        }

        .send {
            width: 38px;
            height: 38px;

            border: none;
            border-radius: 50%;

            background: #007aff;

            color: white;

            font-size: 18px;

            cursor: pointer;
        }

        .send:active {
            transform: scale(0.96);
        }

        @keyframes messageAppear {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>


<body>

<div class="phone">

    <!-- 상태바 -->
    <div class="status-bar">
        <span>05:40</span>

        <div class="status-right">
            <span>▮▮▮</span>
            <span>Wi-Fi</span>
            <span>100%</span>
        </div>
    </div>


    <!-- 채팅 헤더 -->
    <header class="chat-header">

        <button
            class="header-button"
            aria-label="뒤로가기">
            ‹
        </button>

        <div class="profile">

            <div class="avatar">
                М
            </div>

            <div class="name">
                Моя самая сладкая смерть
            </div>

            <div class="status">
                메시지
            </div>

        </div>

        <button
            class="header-button"
            aria-label="정보">
            ⓘ
        </button>

    </header>


    <!-- 메시지 -->
    <section
        class="messages"
        id="messages">

        <div class="date">
            오후 05:40
        </div>

    </section>


    <!-- 안내 -->
    <div class="notice">
        실제 문자 발송 및 서버 저장은 이루어지지 않습니다.
    </div>


    <!-- 입력 -->
    <form
        class="composer"
        id="composer">

        <textarea
            id="input"
            class="input"
            rows="1"
            placeholder="메시지"></textarea>

        <button
            class="send"
            type="submit">
            ↑
        </button>

    </form>

</div>


<script>

    /*
    ======================================
    대화 내용
    ======================================
    */

    const messages = [

        {
            time: "오후 05:42",
            text: "결혼식이 내일이라고 들었어요."
        },

        {
            time: "오후 05:42",
            text: "초대장도 받았고요."
        },

        {
            time: "오후 05:43",
            text: "저는 소좌님 아직 좋아하는데."
        },

        {
            time: "오후 05:44",
            text: "우리 그때로 돌아갈 순 없는 걸까요?"
        },

        {
            time: "오후 05:45",
            text: "저는 소좌님에게 행복하냐고 묻고 싶었어요."
        },

        {
            time: "오후 05:52",
            text: "상트페트르부르크 마린스키 극장에서 기다릴게요."
        },

        {
            time: "오후 05:59",
            text: "늦지 않고 잘 찾아와요."
        }

    ];


    /*
    ======================================
    설정
    ======================================
    */

    const MESSAGE_DELAY = 3000;

    const messagesBox =
        document.getElementById("messages");

    const form =
        document.getElementById("composer");

    const input =
        document.getElementById("input");


    /*
    ======================================
    자동 스크롤
    ======================================
    */

    function scrollBottom() {

        messagesBox.scrollTo({
            top: messagesBox.scrollHeight,
            behavior: "smooth"
        });

    }


    /*
    ======================================
    유빈 메시지 추가
    ======================================
    */

    function addMessage(message, index) {

        const row =
            document.createElement("div");

        row.className =
            "message-row incoming";


        /*
        첫 번째 메시지에만
        발신자 이름 표시
        */

        if (index === 0) {

            const sender =
                document.createElement("div");

            sender.className =
                "sender";

            sender.textContent =
                "Моя самая сладкая смерть";

            row.appendChild(sender);

        }


        const bubble =
            document.createElement("div");

        bubble.className =
            "bubble";

        bubble.textContent =
            message.text;


        const time =
            document.createElement("div");

        time.className =
            "time";

        time.textContent =
            message.time;


        row.appendChild(bubble);
        row.appendChild(time);

        messagesBox.appendChild(row);

        scrollBottom();

    }


    /*
    ======================================
    3초 간격으로 메시지 재생
    ======================================
    */

    async function playMessages() {

        /*
        첫 메시지는 즉시 표시
        */

        addMessage(messages[0], 0);


        /*
        두 번째부터 3초 간격
        */

        for (
            let i = 1;
            i < messages.length;
            i++
        ) {

            await new Promise(
                resolve =>
                    setTimeout(
                        resolve,
                        MESSAGE_DELAY
                    )
            );

            addMessage(
                messages[i],
                i
            );

        }

        /*
        마지막 메시지가 나타나면
        자동 재생 종료
        */

    }


    /*
    ======================================
    방문자 메시지
    ======================================
    */

    form.addEventListener(
        "submit",
        function(event) {

            event.preventDefault();


            const text =
                input.value.trim();


            if (!text) {
                return;
            }


            /*
            방문자가 입력한 메시지는
            실제 서버로 보내지 않는다.
            */

            const row =
                document.createElement("div");

            row.className =
                "message-row outgoing";


            const bubble =
                document.createElement("div");

            bubble.className =
                "bubble";

            bubble.textContent =
                text;


            const error =
                document.createElement("div");

            error.className =
                "error";

            error.textContent =
                "메시지를 전송할 수 없습니다.";


            row.appendChild(bubble);
            row.appendChild(error);


            messagesBox.appendChild(row);


            /*
            입력창 초기화
            */

            input.value = "";

            input.style.height = "auto";


            scrollBottom();

            input.focus();

        }
    );


    /*
    ======================================
    입력창 높이 자동 조절
    ======================================
    */

    input.addEventListener(
        "input",
        function() {

            input.style.height = "auto";

            input.style.height =
                Math.min(
                    input.scrollHeight,
                    100
                ) + "px";

        }
    );


    /*
    ======================================
    Enter = 전송
    Shift + Enter = 줄바꿈
    ======================================
    */

    input.addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter" &&
                !event.shiftKey
            ) {

                event.preventDefault();

                form.requestSubmit();

            }

        }
    );


    /*
    ======================================
    사이트 시작
    ======================================
    */

    playMessages();

</script>

</body>
</html>
'''
